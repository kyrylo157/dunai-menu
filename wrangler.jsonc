{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dunai-menu",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // background paintings (public domain, Wikimedia Commons) and the lace tile
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dunai-menu",
      "database_id": "9c14f83e-2ec1-46ee-8e5a-56ecdbfea3a4",
      "migrations_dir": "migrations"
    }
  ]
  // secrets (wrangler secret put): BOT_TOKEN, ADMIN_PASSWORD, WEBHOOK_SECRET
}
